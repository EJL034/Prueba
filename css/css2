:root {
  --bg-main: linear-gradient(120deg, #eaf6ff 0%, #fdf7ed 45%, #f4f7ff 100%);
  --panel: #ffffff;
  --panel-soft: #f5f9ff;
  --line: #d4deea;
  --ink: #132238;
  --ink-soft: #4a596c;
  --brand: #005cc8;
  --brand-dark: #003f89;
  --accent: #00997a;
  --danger: #c44135;
  --shadow: 0 14px 35px rgba(18, 47, 87, 0.13);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
  background: var(--bg-main);
  color: var(--ink);
  min-height: 100vh;
}

.app-shell {
  width: min(1200px, 94vw);
  margin: 24px auto;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.65);
  box-shadow: var(--shadow);
  border-radius: 18px;
  backdrop-filter: blur(4px);
}

.app-header {
  padding: 28px 28px 16px;
}

.app-header h1 {
  font-size: clamp(1.3rem, 2vw, 2rem);
  margin-bottom: 8px;
}

.app-header p {
  color: var(--ink-soft);
}

.app-nav {
  padding: 0 24px 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.nav-btn,
.btn {
  border: 0;
  border-radius: 999px;
  cursor: pointer;
  padding: 10px 16px;
  font-weight: 700;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.nav-btn {
  background: #dde9f8;
  color: var(--ink);
}

.nav-btn.is-active,
.btn {
  background: var(--brand);
  color: #fff;
}

.nav-btn:hover,
.btn:hover {
  transform: translateY(-1px);
  background: var(--brand-dark);
}

.btn-alt {
  background: #e9f3ef;
  color: #0d5f4d;
}

.btn-alt:hover {
  background: #d4ece4;
}

.btn-small {
  padding: 7px 10px;
  font-size: 0.8rem;
}

.app-main {
  padding: 12px 24px 28px;
}

.modulo {
  display: none;
  animation: fadeIn 0.28s ease;
}

.modulo.is-active {
  display: block;
}

.modulo-head {
  margin-bottom: 14px;
}

.modulo-head h2 {
  margin-bottom: 6px;
}

.modulo-head p {
  color: var(--ink-soft);
}

.tabla-wrap {
  width: 100%;
  overflow-x: auto;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
}

.tabla-incapacidades {
  width: 100%;
  border-collapse: collapse;
  min-width: 980px;
}

.tabla-incapacidades th,
.tabla-incapacidades td {
  padding: 12px;
  border-bottom: 1px solid #edf2f9;
  text-align: left;
  vertical-align: middle;
}

.tabla-incapacidades th {
  background: #f2f7ff;
  color: #17335a;
}

.tabla-incapacidades tbody tr:hover {
  background: #f8fbff;
}

.acciones-columna {
  display: flex;
  gap: 6px;
  align-items: center;
}

.input-mini,
input[type='date'] {
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 8px 10px;
  background: #fff;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 9px;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.78rem;
  border: 1px solid;
}

.estado-en-revision {
  background: #fff9df;
  color: #6f5600;
  border-color: #e3ca68;
}

.estado-aprobada {
  background: #def8ef;
  color: #0a684f;
  border-color: #8fd2bf;
}

.estado-prorrogada {
  background: #e6efff;
  color: #184f9f;
  border-color: #9ebcf2;
}

.estado-finalizada {
  background: #f2f5f9;
  color: #4f5f75;
  border-color: #cad4e0;
}

.filtros-reportes {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin: 16px 0;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px;
}

.filtros-reportes label {
  font-size: 0.9rem;
  color: var(--ink-soft);
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 10px;
}

.kpi-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px;
}

.kpi-card h4 {
  color: var(--ink-soft);
  font-size: 0.9rem;
  margin-bottom: 7px;
}

.kpi-card p {
  font-size: 1.25rem;
  font-weight: 800;
  color: #153767;
}

.analisis-grid {
  margin-top: 14px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.panel-lista {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px;
}

.panel-lista h3 {
  margin-bottom: 10px;
}

.panel-lista ul {
  list-style: none;
}

.panel-lista li {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px dashed #dde6f0;
  padding: 7px 0;
}

.panel-lista.full {
  margin-top: 14px;
}

.comprobante-box {
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 10px;
}

.comprobante-print h3 {
  margin-bottom: 14px;
}

.comprobante-print p {
  padding: 5px 0;
  border-bottom: 1px dashed #e2e7f1;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 14, 38, 0.58);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.modal-overlay.is-open {
  display: flex;
}

.modal-card {
  width: min(500px, 96vw);
  background: #fff;
  border-radius: 16px;
  padding: 18px;
}

.modal-card h3 {
  margin-bottom: 12px;
}

.modal-card form {
  display: grid;
  gap: 10px;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 6px;
}

.toast {
  position: fixed;
  right: 16px;
  bottom: 16px;
  opacity: 0;
  transform: translateY(10px);
  transition: all 0.2s ease;
  padding: 10px 14px;
  border-radius: 10px;
  font-weight: 700;
  pointer-events: none;
}

.toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.toast-ok {
  background: #d9f7ed;
  color: #0f6b53;
}

.toast-error {
  background: #f9dcdb;
  color: #812626;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 980px) {
  .acciones-columna {
    flex-direction: column;
    align-items: stretch;
  }

  .analisis-grid {
    grid-template-columns: 1fr;
  }
}

@media print {
  body {
    background: #fff;
  }

  .app-header,
  .app-nav,
  .btn,
  .toast,
  .modal-overlay,
  .modulo:not([data-modulo='reportar']) {
    display: none !important;
  }

  .modulo[data-modulo='reportar'] {
    display: block !important;
    padding: 0;
  }

  .comprobante-box {
    border: 0;
    box-shadow: none;
    padding: 0;
  }
}
